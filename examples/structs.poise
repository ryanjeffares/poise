struct Vector3 {
    x = 0;
    y = 0;
    z = 0;
}

func main() {
    var v1 = Vector3{};
    var v2 = Vector3{
        x = 1,
        y = 2,
        z = 3,
    };

    println("v1: " + v1);
    println("v2: " + v2);

    final l = [3, 6, 9];

    v1.x = v2.x * l[0];
    v1.y = v2.y * l[1];
    v1.z = v2.z * l[2];

    println("v1: " + v1);
    println("v2: " + v2);

    println(typeof(Vector3));
    println(typeof(Vector3{}));
    assert(typeof(v1) == Vector3);
}

