import std::int;
import std::iterables;
import std::list;
import std::time;

const SIEVE_SIZE = 1000000;
const BIT_COUNT = (SIEVE_SIZE + 1) / 2;
const CORRECT_COUNT = 78498;

func reset(bits: List[Bool]) {
    for i in 0..bits.size() {
        println(i);
        bits[i] = false;
    }
}

func get_bit(bits: List[Bool], index: Int) {
    return index % 2 and bits[index / 2];
}

func clear_bit(bits: List[Bool], index: Int) {
    assert(index % 2 > 0, "Shouldn't be clearing bit at an even index");
    bits[index / 2] = false;
}

func run_sieve(bits: List[Bool]) {
    var factor = 3;
    final max = SIEVE_SIZE.sqrt();

    while factor < max {
        for i in factor..SIEVE_SIZE {
            if get_bit(bits, i) {
                factor = i;
                break;
            }
        }

        for i in (factor * 3)..SIEVE_SIZE by (factor * 2) {
            println(i);
            clear_bit(bits, i);
        }

        factor = factor + 2;
    }
}

func main() {
    final bits = [true].repeat(BIT_COUNT);
    final start = std::time::time();
    var passes = 0;

    // while std::time::time() - start < 5.0 {
        println("Resetting");
        reset(bits);
        println("Running");
        run_sieve(bits);
       //  passes = passes + 1;
    // }

    final count = bits.filter(|| (final b) => b).size();
    if count == CORRECT_COUNT {
        println("Found " + count + " primes under " + SIEVE_SIZE + " " + passes + " times");
    } else {
        eprintln("Found incorrect number of primes " + count + ", expected " + CORRECT_COUNT);
    }
}

